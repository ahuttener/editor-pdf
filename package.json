{
  "name": "editorpdf",
  "productName": "Editor PDF",
  "version": "1.0.0",
  "description": "Editor de PDF para Windows: editar texto existente, adicionar texto, imagem e assinatura, organizar páginas e preencher formulários.",
  "author": {
    "name": "CyberSecInfo",
    "email": "info@cybersecinfo.com",
    "url": "https://cybersecinfo.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "fixtures": "node scripts/make-fixtures.mjs",
    "selftest": "node scripts/make-fixtures.mjs && electron . --selftest=test-output && node scripts/verify.mjs test-output",
    "dist": "node scripts/prepare-vendor.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "docx": "^9.11.0",
    "fabric": "^7.4.0",
    "mupdf": "^1.28.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.adriano.editorpdf",
    "productName": "Editor PDF",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "engine/**/*",
      "vendor/**/*",
      "build/icon.png",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.cts",
      "!**/README*",
      "!**/CHANGELOG*",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/build/pdf.mjs",
      "!node_modules/pdfjs-dist/build/pdf.worker.mjs",
      "!node_modules/pdfjs-dist/build/pdf.sandbox*",
      "!node_modules/fabric/dist/fabric.*",
      "!node_modules/fabric/dist/index.mjs",
      "!node_modules/fabric/dist/index.node.*",
      "!node_modules/fabric/dist/package.*",
      "!node_modules/fabric/dist/index.js",
      "!node_modules/fabric/dist/index.cjs",
      "!node_modules/fabric/src/**",
      "!node_modules/fabric/dist/src/**",
      "!node_modules/docx/dist/{charts,html,layout,math,shapes,watermarks}.*",
      "!node_modules/docx/dist/index.iife.js",
      "!node_modules/docx/dist/index.umd.cjs",
      "!node_modules/@tesseract.js-data/**",
      "!node_modules/mupdf/dist/*.br",
      "!node_modules/pdf-lib/es/**",
      "!node_modules/pdf-lib/cjs/**/*.map",
      "!node_modules/pdf-lib/src/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Editor PDF",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "installerIcon": "build/installer.ico",
      "uninstallerIcon": "build/installer.ico",
      "multiLanguageInstaller": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "unicode": true,
      "installerLanguages": [
        "pt_BR",
        "en_US"
      ]
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "description": "Documento PDF",
        "role": "Editor"
      }
    ],
    "copyright": "© 2026 CyberSecInfo",
    "mac": {
      "icon": "build/icon-1024.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "icon": "build/icon-1024.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "synopsis": "PDF editor",
      "maintainer": "CyberSecInfo <info@cybersecinfo.com>"
    },
    "asar": false
  },
  "homepage": "https://cybersecinfo.com"
}
